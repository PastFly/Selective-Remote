CLOUD_HOST=0.0.0.0
CLOUD_PORT=8080
CLOUD_PUBLIC_ORIGIN=https://cloud.pastfly.ru
ACME_EMAIL=replace-with-your-certificate-contact-email
DATABASE_URL=postgres://selective_remote:replace-me@postgres:5432/selective_remote
POSTGRES_DB=selective_remote
POSTGRES_USER=selective_remote
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
EMAIL_VERIFICATION_TOKEN_PEPPER=replace-with-a-different-32-byte-random-secret
PASSWORD_RESET_TOKEN_PEPPER=replace-with-an-independent-32-byte-secret
TEAM_INVITATION_TOKEN_PEPPER=replace-with-an-independent-team-invitation-secret
TEAM_OUTBOX_ENCRYPTION_KEY=replace-with-an-independent-team-outbox-key
ABUSE_TOKEN_PEPPER=replace-with-another-independent-32-byte-secret
PROXY_SHARED_SECRET=replace-with-exactly-64-lowercase-hex-characters
# Optional while ALLOW_REGISTRATION=false. Uncomment and configure all six
# values together before enabling registration.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=replace-with-smtp-user
# SMTP_PASSWORD=replace-with-at-least-16-random-characters
# SMTP_FROM=no-reply@pastfly.ru
ALLOW_REGISTRATION=false
SESSION_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_EMAIL_LIMIT=3
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_VERIFY_IP_LIMIT=30
AUTH_RESEND_IP_LIMIT=5
AUTH_RESEND_EMAIL_LIMIT=3
AUTH_PASSWORD_RESET_REQUEST_IP_LIMIT=5
AUTH_PASSWORD_RESET_REQUEST_EMAIL_LIMIT=3
AUTH_PASSWORD_RESET_IP_LIMIT=10
TEAM_INVITATION_CREATE_USER_LIMIT=50
TEAM_INVITATION_ACCEPT_IP_LIMIT=20
DEVICE_KEY_BOOTSTRAP_USER_LIMIT=5
DEVICE_KEY_BOOTSTRAP_IP_LIMIT=20
AUTH_RECOVERY_MIN_RESPONSE_MS=500
